<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Def_Tinteiro" targetNamespace="https://github.com/MaisaGD/tinteiro-ink-bpmn">
  <collaboration id="Collab_Tinteiro">
    <participant id="Pool_Tinteiro" name="Tinteiro INK — Controle de estoque e consumo de tintas" processRef="Proc_Tinteiro"/>
  </collaboration>
  <process id="Proc_Tinteiro" name="Tinteiro INK" isExecutable="false">
    <laneSet id="LaneSet_1">
      <lane id="L_coord" name="Coordenação / Gerência">
        <flowNodeRef>S4</flowNodeRef>
        <flowNodeRef>T17</flowNodeRef>
        <flowNodeRef>T18</flowNodeRef>
        <flowNodeRef>G6</flowNodeRef>
        <flowNodeRef>T19</flowNodeRef>
        <flowNodeRef>ED1</flowNodeRef>
        <flowNodeRef>ED2</flowNodeRef>
      </lane>
      <lane id="L_estoque" name="Equipe de Estoque">
        <flowNodeRef>S1</flowNodeRef>
        <flowNodeRef>T1</flowNodeRef>
        <flowNodeRef>T3</flowNodeRef>
        <flowNodeRef>G1</flowNodeRef>
        <flowNodeRef>T4</flowNodeRef>
        <flowNodeRef>T5</flowNodeRef>
        <flowNodeRef>T6</flowNodeRef>
        <flowNodeRef>G2</flowNodeRef>
        <flowNodeRef>E1</flowNodeRef>
        <flowNodeRef>S5</flowNodeRef>
        <flowNodeRef>T20</flowNodeRef>
        <flowNodeRef>T21</flowNodeRef>
        <flowNodeRef>G7</flowNodeRef>
        <flowNodeRef>T22</flowNodeRef>
        <flowNodeRef>EE1</flowNodeRef>
        <flowNodeRef>EE2</flowNodeRef>
      </lane>
      <lane id="L_sistema" name="Sistema Tinteiro (Supabase + Render)">
        <flowNodeRef>T2</flowNodeRef>
        <flowNodeRef>T9</flowNodeRef>
        <flowNodeRef>G3</flowNodeRef>
        <flowNodeRef>T10</flowNodeRef>
        <flowNodeRef>EB1</flowNodeRef>
        <flowNodeRef>EB2</flowNodeRef>
        <flowNodeRef>S3</flowNodeRef>
        <flowNodeRef>T12</flowNodeRef>
        <flowNodeRef>G4</flowNodeRef>
        <flowNodeRef>T13</flowNodeRef>
        <flowNodeRef>EC1</flowNodeRef>
        <flowNodeRef>T14</flowNodeRef>
        <flowNodeRef>T15</flowNodeRef>
        <flowNodeRef>G5</flowNodeRef>
        <flowNodeRef>T16</flowNodeRef>
        <flowNodeRef>EC3</flowNodeRef>
        <flowNodeRef>EC2</flowNodeRef>
      </lane>
      <lane id="L_operador" name="Operador de Impressão">
        <flowNodeRef>S2</flowNodeRef>
        <flowNodeRef>T7</flowNodeRef>
        <flowNodeRef>T8</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="S1" name="Tintas e insumos recebidos">
      <outgoing>F1</outgoing>
      <messageEventDefinition id="MD_S1"/>
    </startEvent>
    <task id="T1" name="Lançar nota fiscal e lote de compra">
      <incoming>F1</incoming>
      <outgoing>F2</outgoing>
    </task>
    <task id="T2" name="Gerar QR code para cada garrafa">
      <incoming>F2</incoming>
      <outgoing>F3</outgoing>
    </task>
    <task id="T3" name="Imprimir etiquetas e identificar garrafas">
      <incoming>F3</incoming>
      <outgoing>F4</outgoing>
    </task>
    <exclusiveGateway id="G1" name="Destino da garrafa?">
      <incoming>F4</incoming>
      <outgoing>F5</outgoing>
      <outgoing>F6</outgoing>
    </exclusiveGateway>
    <task id="T4" name="Armazenar no almoxarifado RJ">
      <incoming>F5</incoming>
      <outgoing>F8</outgoing>
    </task>
    <task id="T5" name="Registrar transferência para SP">
      <incoming>F6</incoming>
      <outgoing>F7</outgoing>
    </task>
    <task id="T6" name="Conferir recebimento da transferência">
      <incoming>F7</incoming>
      <outgoing>F9</outgoing>
    </task>
    <exclusiveGateway id="G2" name="">
      <incoming>F8</incoming>
      <incoming>F9</incoming>
      <outgoing>F10</outgoing>
    </exclusiveGateway>
    <endEvent id="E1" name="Garrafa disponível em estoque">
      <incoming>F10</incoming>
    </endEvent>
    <startEvent id="S2" name="Garrafa acaba na impressora">
      <outgoing>F11</outgoing>
      <conditionalEventDefinition id="CD_S2"><condition xsi:type="tFormalExpression">Garrafa vazia</condition></conditionalEventDefinition>
    </startEvent>
    <task id="T7" name="Trocar garrafa na impressora">
      <incoming>F11</incoming>
      <outgoing>F12</outgoing>
    </task>
    <task id="T8" name="Ler QR code da garrafa">
      <incoming>F12</incoming>
      <outgoing>F13</outgoing>
    </task>
    <task id="T9" name="Dar baixa da garrafa no estoque">
      <incoming>F13</incoming>
      <outgoing>F14</outgoing>
    </task>
    <exclusiveGateway id="G3" name="Estoque abaixo do mínimo?">
      <incoming>F14</incoming>
      <outgoing>F15</outgoing>
      <outgoing>F16</outgoing>
    </exclusiveGateway>
    <task id="T10" name="Enviar alerta de estoque mínimo">
      <incoming>F15</incoming>
      <outgoing>F17</outgoing>
    </task>
    <endEvent id="EB1" name="Reposição sinalizada">
      <incoming>F17</incoming>
    </endEvent>
    <endEvent id="EB2" name="Baixa concluída">
      <incoming>F16</incoming>
    </endEvent>
    <startEvent id="S3" name="Todo dia">
      <outgoing>F18</outgoing>
      <timerEventDefinition id="TD_S3"/>
    </startEvent>
    <task id="T12" name="Coletar consumo na API Kornit Konnect">
      <incoming>F18</incoming>
      <outgoing>F19</outgoing>
    </task>
    <exclusiveGateway id="G4" name="Coleta concluída?">
      <incoming>F19</incoming>
      <outgoing>F20</outgoing>
      <outgoing>F21</outgoing>
    </exclusiveGateway>
    <task id="T13" name="Enviar alerta de falha na coleta">
      <incoming>F21</incoming>
      <outgoing>F22</outgoing>
    </task>
    <endEvent id="EC1" name="Falha comunicada">
      <incoming>F22</incoming>
    </endEvent>
    <task id="T14" name="Gravar consumo por máquina">
      <incoming>F20</incoming>
      <outgoing>F23</outgoing>
    </task>
    <task id="T15" name="Verificar garrafas próximas do vencimento">
      <incoming>F23</incoming>
      <outgoing>F24</outgoing>
    </task>
    <exclusiveGateway id="G5" name="Há garrafas a vencer?">
      <incoming>F24</incoming>
      <outgoing>F25</outgoing>
      <outgoing>F26</outgoing>
    </exclusiveGateway>
    <task id="T16" name="Enviar alerta de vencimento">
      <incoming>F25</incoming>
      <outgoing>F27</outgoing>
    </task>
    <endEvent id="EC3" name="Vencimento comunicado">
      <incoming>F27</incoming>
    </endEvent>
    <endEvent id="EC2" name="Consumo do dia registrado">
      <incoming>F26</incoming>
    </endEvent>
    <startEvent id="S4" name="Toda semana">
      <outgoing>F28</outgoing>
      <timerEventDefinition id="TD_S4"/>
    </startEvent>
    <task id="T17" name="Receber resumo semanal por e-mail">
      <incoming>F28</incoming>
      <outgoing>F29</outgoing>
    </task>
    <task id="T18" name="Analisar consumo, custo e desperdício no dashboard">
      <incoming>F29</incoming>
      <outgoing>F30</outgoing>
    </task>
    <exclusiveGateway id="G6" name="Precisa de ação?">
      <incoming>F30</incoming>
      <outgoing>F31</outgoing>
      <outgoing>F32</outgoing>
    </exclusiveGateway>
    <task id="T19" name="Definir ação (compra, ajuste ou desperdício)">
      <incoming>F31</incoming>
      <outgoing>F33</outgoing>
    </task>
    <endEvent id="ED1" name="Ação definida">
      <incoming>F33</incoming>
    </endEvent>
    <endEvent id="ED2" name="Semana acompanhada">
      <incoming>F32</incoming>
    </endEvent>
    <startEvent id="S5" name="Inventário periódico">
      <outgoing>F34</outgoing>
      <timerEventDefinition id="TD_S5"/>
    </startEvent>
    <task id="T20" name="Fazer contagem física das garrafas">
      <incoming>F34</incoming>
      <outgoing>F35</outgoing>
    </task>
    <task id="T21" name="Registrar contagem no Tinteiro">
      <incoming>F35</incoming>
      <outgoing>F36</outgoing>
    </task>
    <exclusiveGateway id="G7" name="Há divergência?">
      <incoming>F36</incoming>
      <outgoing>F37</outgoing>
      <outgoing>F38</outgoing>
    </exclusiveGateway>
    <task id="T22" name="Ajustar saldo e registrar o motivo">
      <incoming>F37</incoming>
      <outgoing>F39</outgoing>
    </task>
    <endEvent id="EE1" name="Saldo ajustado">
      <incoming>F39</incoming>
    </endEvent>
    <endEvent id="EE2" name="Inventário conferido">
      <incoming>F38</incoming>
    </endEvent>
    <sequenceFlow id="F1" name="" sourceRef="S1" targetRef="T1"/>
    <sequenceFlow id="F2" name="" sourceRef="T1" targetRef="T2"/>
